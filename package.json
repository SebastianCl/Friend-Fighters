  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "ajv": "^8.20.0",
    "prettier": "^3.9.8",
    "typescript": "~5.9.3",
    "vite": "^6.4.1",
    "vitest": "^4.1.11"
  }
}
